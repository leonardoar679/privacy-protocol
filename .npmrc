# the sixth review round (2026-11-03): no install script runs on this machine before the dependency review has read it — the two
# packages whose scripts are reviewed (esbuild: the platform binary comes as an optional dependency; @reown/appkit: a version
# check) need none to work; a package that truly needs its script is rebuilt by hand after its review (npm rebuild <name>)
ignore-scripts=true
# the Node major CI and the release machine run (.nvmrc; package.json engines)
engine-strict=true
