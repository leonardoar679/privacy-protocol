{
  "name": "tornado-classic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "Tornado Classic: an original-style interface for the existing Tornado Cash Classic pools on Ethereum mainnet (V7; docs/privacy-wallet-web-spec-v3.0.md section 7). A separately built, separately locked and separately licensed app served under /classic/; it shares nothing at runtime with the Privacy Wallet.",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --port 5174",
    "test": "vitest run",
    "lint": "eslint .",
    "gates": "node scripts/gates.mjs",
    "check-build": "node scripts/check-build.mjs",
    "tokens": "node scripts/tokens.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
