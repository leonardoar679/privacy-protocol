pragma solidity ^0.8.24;

import {Test} from "../utils/MiniTest.sol";
import {Groth16Verifier, ITransactionGroth16Verifier} from "../../src/verifier/Groth16Verifier.sol";
import {IProofVerifier} from "../../src/verifier/IProofVerifier.sol";
import {TransactionVerifierDev} from "../../src/verifier/dev/TransactionVerifierDev.sol";
import {DevProofFixtures as F} from "./DevProofFixtures.sol";

/// REAL Groth16 proofs of circuits/transaction.circom (generated by circuits/test/prove.mjs), checked
/// by the snarkjs-generated verifier on the EVM's BN254 precompiles, through the same IProofVerifier
/// interface PrivacyCore calls. Closes the circuit -> proof -> on-chain-verifier loop that the
/// MockVerifier suites deliberately leave open. (Dev setup: insecure by design, tests only.)
contract Groth16RealProofTest is Test {
    uint256 internal constant R = 21888242871839275222246405745257275088548364400416034343698204186575808495617;

    IProofVerifier internal verifier;

    function setUp() public {
        verifier = new Groth16Verifier(ITransactionGroth16Verifier(address(new TransactionVerifierDev())));
    }

    function _pub(uint256[14] memory p) internal pure returns (uint256[] memory out) {
        out = new uint256[](14);
        for (uint256 i; i < 14; ++i) {
            out[i] = p[i];
        }
    }

    function _proof(F.Fixture memory f) internal pure returns (bytes memory) {
        return abi.encode(f.a, f.b, f.c);
    }

    function test_RealTransferProofVerifies() public view {
        F.Fixture memory f = F.transfer();
        assertTrue(verifier.verify(_pub(f.pub), _proof(f)), "real transfer proof verifies on-chain");
    }

    function test_RealWithdrawProofVerifies() public view {
        F.Fixture memory f = F.withdraw();
        assertTrue(verifier.verify(_pub(f.pub), _proof(f)), "real withdraw proof verifies on-chain");
    }

    /// Every one of the 14 public inputs (root, nullifiers, outputs, mode, vault, amount, recipient,
    /// note-data hashes, chainId) is bound: changing any single one invalidates the proof.
    function test_EveryPublicInputIsBound() public view {
        F.Fixture memory f = F.withdraw();
        for (uint256 k; k < 14; ++k) {
            uint256[] memory p = _pub(f.pub);
            p[k] = addmod(p[k], 1, R);
            assertFalse(verifier.verify(p, _proof(f)), "tampered public input accepted");
        }
    }

    function test_ProofNotReplayableAcrossTransactions() public view {
        F.Fixture memory t = F.transfer();
        F.Fixture memory w = F.withdraw();
        assertFalse(verifier.verify(_pub(w.pub), _proof(t)), "transfer proof accepted for withdraw inputs");
        assertFalse(verifier.verify(_pub(t.pub), _proof(w)), "withdraw proof accepted for transfer inputs");
    }

    function test_MalformedProofPointRejected() public view {
        F.Fixture memory f = F.transfer();
        f.a[1] = addmod(f.a[1], 1, R); // A no longer on the curve -> precompile fails -> false
        assertFalse(verifier.verify(_pub(f.pub), _proof(f)), "off-curve proof accepted");
    }

    /// A public input >= r is an alias of a smaller field element; the verifier must reject it
    /// rather than reduce it (canonical encoding, spec §59).
    function test_NonCanonicalPublicInputRejected() public view {
        F.Fixture memory f = F.transfer();
        uint256[] memory p = _pub(f.pub);
        p[6] += R; // mode: 0 -> R (≡ 0 mod r)
        assertFalse(verifier.verify(p, _proof(f)), "non-canonical public input accepted");
    }

    function test_WrongPublicInputCountReverts() public {
        F.Fixture memory f = F.transfer();
        uint256[] memory p = new uint256[](13);
        vm.expectRevert(Groth16Verifier.BadPublicInputCount.selector);
        verifier.verify(p, _proof(f));
    }

    function test_InnerMustBeAContract() public {
        vm.expectRevert(Groth16Verifier.InnerNotContract.selector);
        new Groth16Verifier(ITransactionGroth16Verifier(address(0xdead)));
    }
}
