{
  "name": "@privacy-wallet/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The design system (doc §8–§12; spec v2.0 §5): the tokens and their stylesheet, the icons, the wrapped Radix primitives and the component inventory every screen is composed from. Presentation only: it never imports the SDK or an engine.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./labels": "./src/labels.ts",
    "./cx": "./src/cx.ts",
    "./Gallery": "./src/Gallery.tsx",
    "./icons": "./src/icons/index.tsx",
    "./primitives": "./src/primitives/index.ts",
    "./primitives/*": "./src/primitives/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./*.css": "./src/*.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "tokens": "vite-node scripts/build-tokens.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-visually-hidden": "^1.2.12"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
