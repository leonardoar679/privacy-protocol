{
  "name": "@privacy-wallet/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The design system (doc §6–§12, §55–§57; spec v2.0 §5): the tokens and their stylesheet, the self-hosted Inter, the icons, the wrapped Radix primitives, the component inventory of doc §9 and the patterns every screen is composed from. Presentation only: it never imports the SDK or an engine.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./labels": "./src/labels.ts",
    "./cx": "./src/cx.ts",
    "./format": "./src/format.ts",
    "./Preview": "./src/Preview.tsx",
    "./icons": "./src/icons/index.tsx",
    "./primitives": "./src/primitives/index.ts",
    "./primitives/*": "./src/primitives/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./patterns": "./src/patterns/index.ts",
    "./patterns/*": "./src/patterns/*.tsx",
    "./animations": "./src/animations/index.ts",
    "./*.css": "./src/*.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "tokens": "vite-node scripts/build-tokens.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-visually-hidden": "^1.2.12"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "axe-core": "^4.14.0",
    "happy-dom": "^15.11.7",
    "jsdom": "^30.1.2"
  }
}
