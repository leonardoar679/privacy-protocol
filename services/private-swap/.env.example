# PrivateSwap service / CLI configuration (optional: every value has a default). No keys: the service never holds money keys.

PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The pool deployment orders are built for (must match the wallet's VITE_* and the relayer's CORE/FEE_VAULT)
CHAIN_ID=11155111
SWAP_FACTORY=0x0000000000000000000000000000000000000000   # SwapOrderFactory (contracts/script/DeploySwapPeriphery.s.sol)
# ERC-20 refund vaults (plan §36): the canonical vault per token a failed ERC-20 swap re-shields into.
# They also decide which routes swap first: a route that swaps into a token before bridging (LI.FI's swap
# variants, Across's swap leg, e.g. ETH -> USDC on an L2) is offered only if that token is listed here,
# since an unfilled deposit comes back in it and the escrow's refundToken re-shields it into this vault.
# WETH and ETH need no entry for an order in a token: the escrow re-shields them as ETH into NATIVE_VAULT.
# ERC20_VAULTS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48:0x0000000000000000000000000000000000000000
NATIVE_VAULT=0x0000000000000000000000000000000000000000   # canonical ETH vault (refunds re-shield there)
TIP_BPS=25
REFUND_WINDOW_SECONDS=7200

# Provider endpoints (mainnet defaults; override to point adapters at other gateways / testnets)
# THORNODE_URL=https://…            # an extra THORNode gateway (the quorum needs 2 distinct answering gateways)
# THORNODE_QUORUM=2
# LIFI_URL=https://li.quest/v1
# LIFI_API_KEY=
# CHAINFLIP_BACKEND=https://chainflip-swap.chainflip.io
# CHAINFLIP_RPC=https://mainnet-rpc.chainflip.io
# MAYAN_PRICE_API=https://price-api.mayan.finance/v3
# MAYAN_EXPLORER_API=https://explorer-api.mayan.finance/v3
# MAYAN_FAST_MCTP=0xc1062b7c5dc8e4b1df9f200fe360cdc0ed6e7741
# MAYAN_SWIFT_V2=0x40ffe85a28dc9993541449464d7529a922142960
# MAYAN_ORDER_TYPES=FAST_MCTP,SWIFT   # Mayan order types quoted; the higher guaranteed minimum wins, SWIFT on a tie
# ONECLICK_API=https://1click.chaindefuser.com
# ONECLICK_CONTRACT_DEPOSITS_CONFIRMED=0                  # set to 1 only once 1Click confirms contract-sent deposits are credited
# ACROSS_API=https://app.across.to/api
