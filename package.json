{
  "name": "privacy-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Immutable, non-custodial Ethereum L1 shielded pool (V1 scaffold). Contracts are a separate Foundry project under contracts/.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:reference": "npm --workspace packages/protocol run test",
    "vectors": "npm --workspace packages/protocol run vectors",
    "dev:web": "npm --workspace apps/web run dev"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
