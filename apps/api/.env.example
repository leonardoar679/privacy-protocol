# The API (Express 5 + node:sqlite; spec v2.0 §15) — copy to .env and export, or set in the service manager. It holds no
# keys and no user data beyond the swap records of its retention window (docs/audit-package.md gap 34).

PORT=8787
HOST=127.0.0.1
DB_PATH=api.sqlite                                   # the swap records (WAL); purged on schedule (src/db.ts RETENTION)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_PER_MINUTE=120                                  # per socket (no proxy header is trusted)
# TLS=1                                              # only when the API terminates TLS itself (HSTS); behind a proxy, the proxy sends it
RELAYER_URL=http://127.0.0.1:8790                    # read for its /info (the fee terms, cached 30 s) and its public job endpoints
# RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org   # the chain reads of reconcile, the gas-based tips, the prices

# The zkAPI quote gateway (whale spec §22): unset, GET /v1/gateway/health says "not available upstream"
# ZKAPI_UPSTREAM=
# ZKAPI_REQUEST_CHARGE_CAP=0.01

# The swap engine it runs in-process reads its own variables: the pool deployment (CHAIN_ID, SWAP_FACTORY, NATIVE_VAULT,
# ERC20_VAULTS), the refund window, the risk database and the provider endpoints — see packages/swap-engine/.env.example.
