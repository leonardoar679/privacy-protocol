{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@ref/*": [
        "../../packages/protocol/src/*"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/protocol/src/keys.ts",
    "../../packages/protocol/src/note.ts",
    "../../packages/protocol/src/prover.ts",
    "../../packages/protocol/src/txInputs.ts",
    "../../packages/protocol/src/merkle.ts",
    "../../packages/protocol/src/payload.ts",
    "../../packages/protocol/src/wallet/amounts.ts"
  ]
}
