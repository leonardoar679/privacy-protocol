{
  "name": "@privacy-wallet/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy wallet (Vite + React + TS + viem): client-side proving, encrypted keystore + journal, fresh per-chain addresses, private swaps, Private AI on zkAPI. The raw seed is never written to dapp-origin storage (TC-01).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "zkapi:assets": "node scripts/build-zkapi-assets.mjs",
    "zkapi:pins": "node scripts/check-zkapi-pins.mjs",
    "core:assets": "node scripts/copy-core-assets.mjs",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@privacy-wallet/config": "*",
    "@privacy-wallet/contracts": "*",
    "@privacy-wallet/privacy-engine": "*",
    "@privacy-wallet/protocol": "*",
    "@privacy-wallet/protocol-types": "*",
    "@privacy-wallet/risk-engine": "*",
    "@privacy-wallet/sdk": "*",
    "@privacy-wallet/ui": "*",
    "@privacy-wallet/wallet-engine": "*",
    "qrcode-generator": "^1.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "snarkjs": "^0.7.6",
    "viem": "^2.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@privacy-wallet/swap-engine": "*",
    "@scure/base": "^1.2.6",
    "@scure/bip39": "^1.6.0",
