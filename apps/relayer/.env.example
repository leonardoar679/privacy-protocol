# Relayer configuration (copy to .env and `export $(cat .env | xargs)` or set in the service manager). Never commit the real file.
# Every number is read strictly: one that is not a whole number in its range stops the start, naming the setting.

RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
CORE=0x0000000000000000000000000000000000000000          # PrivacyCore
FEE_VAULT=0x0000000000000000000000000000000000000000     # the canonical ETH vault: fee notes are notes in it

RELAYER_PRIVATE_KEY=0x…                                   # the gas EOA: holds gas only, never user funds
RELAYER_SEED=change me: the relayer wallet seed            # fee notes are paid to this wallet (utf8, or 0x-hex bytes)

MIN_FEE_WEI=0                                            # floor; the live minimum is gasEstimate × gasPrice × (1 + margin)
GAS_ESTIMATE=1800000
FEE_MARGIN_BPS=2000
# V5 (Privacy Wallet Web spec §10): the privacy fee, basis points of a withdrawal's amount (100 = 1.00 %); the floor still applies; 0 = none
FEE_PERCENT_BPS=100
REQUIRE_READABLE_FEE_PAYLOAD=1                           # refuse fee notes not encrypted to this relayer's view key
# ERC-20 vaults the relayer takes fee notes in (plan §36), fixed minimum per vault in token base units (no oracle: reprice by config)
# FEE_VAULTS={"0x0000000000000000000000000000000000000000":{"symbol":"USDC","decimals":6,"minFee":"2000000"}}

RELAYER_JOURNAL_DIR=journal                              # durable submissions + swap jobs (gitignored)
SWAP_POLL_MS=15000                                       # swap executor cadence
LATE_REFUND_WATCH_SECONDS=86400                          # an executed order is watched this long past refundAfter for a late provider refund
MAX_UNPAID_REFUNDS=3                                     # re-shields per executed order that no tip pays for (each above its floor; PP-S12)
RATE_PER_MINUTE=60                                       # per-caller token bucket (burst ≤ 20): the socket, or the address the trusted proxies saw
# TRUST_PROXY_HOPS=1                                     # behind a proxy: how many append to X-Forwarded-For (unset: none trusted)
# the deployment's SwapOrderFactory: the swap executor admits orders for it only (unset: no swap jobs, the routes answer 503)
SWAP_FACTORY=0x0000000000000000000000000000000000000000
# the swap service's signing address (its GET /v1/status deployment.voucher): only what it vouched for runs (unset: no swap jobs);
# while it rotates its key, the new address and the former one, comma-separated
API_VOUCHER=0x0000000000000000000000000000000000000000
# V6 Stage 12 (spec v2.0 §11.2): the ShieldReceiverFactory this relayer shields same-chain swap deliveries for (unset: no shield jobs)
# SHIELD_FACTORY=0x0000000000000000000000000000000000000000
LATE_DELIVERY_WATCH_SECONDS=86400                        # a receipt is watched this long past its delivery deadline
MAX_UNPAID_SHIELDS=3                                     # shields per receipt that no tip pays for (a delivery below its minimum, a late one)
# V6 Stage 15 (spec v2.0 §17): the edge, as the API's
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TLS=1                                                  # only when the relayer terminates TLS itself (HSTS)
# RELAYER_ADMIN_TOKEN=                                   # opens GET /swap and GET /jobs (the whole job lists) to operators; unset: closed
MAX_SWAP_JOBS=1000
PORT=8790
HOST=127.0.0.1
