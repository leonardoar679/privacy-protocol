{
  "name": "privacy-protocol-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy wallet (Vite + React + TS + viem): client-side proving, encrypted keystore + journal, fresh per-chain addresses, private swaps, Private AI on zkAPI. The raw seed is never written to dapp-origin storage (TC-01).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "zkapi:assets": "node scripts/build-zkapi-assets.mjs",
    "zkapi:pins": "node scripts/check-zkapi-pins.mjs",
    "core:assets": "node scripts/copy-core-assets.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@openanonymity/zkapi-browser-sdk": "file:../../zkapi",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "qrcode-generator": "^1.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "snarkjs": "^0.7.6",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
