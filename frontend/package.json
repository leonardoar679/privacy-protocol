{
  "name": "privacy-protocol-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "V1 wallet shell (Vite + React + TS + viem). Client-side proving is stubbed; the raw spending secret is NEVER written to dapp-origin localStorage (the TC-01 fix).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "zkapi:assets": "node scripts/build-zkapi-assets.mjs",
    "zkapi:pins": "node scripts/check-zkapi-pins.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@openanonymity/zkapi-browser-sdk": "file:../../zkapi",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "snarkjs": "^0.7.6",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
