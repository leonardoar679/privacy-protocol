# Wallet configuration (Vite reads VITE_* at build/dev time). Copy to .env.local; never commit secrets (there are none here).

# The pool deployment the wallet talks to (contracts/deployments/<network>.json after a deploy; docs/testnet.md)
# Several endpoints (comma-separated) are read in parallel and must agree on every view the wallet proves against (plan §38); one URL also works (VITE_RPC_URL)
VITE_RPC_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://rpc.sepolia.org
VITE_CHAIN_ID=11155111
VITE_CORE=0x0000000000000000000000000000000000000000
VITE_ETH_VAULT=0x0000000000000000000000000000000000000000
VITE_FROM_BLOCK=0
# Private ERC-20 assets (plan §36): SYMBOL:0xtoken:0xvault:decimals, comma-separated; the vault is the token's canonical vault from the factory.
# The same list decides which swap routes the wallet signs: a route that swaps into a token before bridging is
# accepted only if that token is listed (its refund note lands in that vault, where this wallet can see it).
# WETH and ETH need no entry for an order in a token: the escrow re-shields them as ETH into VITE_ETH_VAULT.
# VITE_ERC20_VAULTS=USDC:0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48:0x0000000000000000000000000000000000000000:6
# The SwapOrderFactory of this deployment: the wallet recomputes every swap escrow from it and refuses
# to commit or fund an order without it (a swap service cannot redirect a withdrawal)
# VITE_SWAP_FACTORY=0x0000000000000000000000000000000000000000
# Ethereum light client (mainnet, Sepolia): before every transaction the wallet proves the pool's root and
# leaf count at the latest finalized block. Beacon APIs serving the light-client routes with CORS (default:
# ChainSafe Lodestar + PublicNode); a checkpoint block root you trust (else, on first use, a finalized
# root every beacon API reports identically). The RPC endpoints above must serve eth_getProof about 100
# blocks deep (dRPC, MEV Blocker and merkle.io do on mainnet; PublicNode, Flashbots and 1RPC cap it).
# VITE_BEACON_URLS=https://lodestar-mainnet.chainsafe.io,https://ethereum-beacon-api.publicnode.com
# VITE_LC_CHECKPOINT=0x…
# Public THORNode gateways the wallet asks for THORChain's inbound vault before signing a THORChain swap
# (the same request for every user; all that answer must agree, VITE_THORNODE_QUORUM of them at least).
# VITE_THORNODE_URLS=https://gateway.liquify.com/chain/thorchain_api,https://rest.cosmos.directory/thorchain,https://thorchain-thornode-lb-1.thorwallet.org
# VITE_THORNODE_QUORUM=2
# THORChain's Ethereum router, pinned; set only after THORChain upgrades it (the wallet refuses other routers)
# VITE_THORCHAIN_ROUTER=0xD37BbE5744D730a1d98d8DC97c42F0Ca46aD7146

# Local services (loopback by default)
VITE_SWAP_SERVICE=http://127.0.0.1:8787
VITE_RELAYER_URL=http://127.0.0.1:8790
# More relayers to fall back to when the first is unreachable (plan §85 rule 5); the wallet picks the first that serves this chain / core and takes fees in the asset
# VITE_RELAYER_URLS=http://127.0.0.1:8790,https://relayer.example

# Circuit artifacts for the in-browser prover: served from ../circuits by the dev server; set for a deployed build
# VITE_ARTIFACT_BASE=https://your.host/artifacts

# zkAPI (Private AI tab): which network the SDK assets were built for (npm run zkapi:assets && npm run zkapi:pins)
ZKAPI_NETWORK=sepolia
