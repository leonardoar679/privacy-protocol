{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@ref/*": ["../reference/typescript/src/*"] }
  },
  "include": ["src", "../reference/typescript/src/keys.ts", "../reference/typescript/src/note.ts", "../reference/typescript/src/prover.ts", "../reference/typescript/src/txInputs.ts", "../reference/typescript/src/merkle.ts", "../reference/typescript/src/payload.ts", "../reference/typescript/src/wallet/amounts.ts"]
}
